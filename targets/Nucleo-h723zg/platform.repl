// Edit the template in scripts/codegen/templates/platform.repl.jinja instead

using "renode/platforms/stm32h723.repl"

led_1: Miscellaneous.LED @ sysbus
led_2: Miscellaneous.LED @ sysbus
led_3: Miscellaneous.LED @ sysbus

gpioPortB:
    0 -> led_1@0

gpioPortE:
    1 -> led_2@0

gpioPortB:
    14 -> led_3@0

adis16500: Sensors.ADIS16500 @ spi1

gpioPortD:
    14 -> adis16500@0

lsm6dsv: Sensors.LSM6DSV @ spi2

gpioPortA:
    9 -> lsm6dsv@0

lps25hbtr: Sensors.LPS25HBTR @ i2c1 89


servo_pitch: Sensors.Servo @ sysbus
    minPulseWidthUs: 500
    maxPulseWidthUs: 2500
    minAngle: -90
    maxAngle: 90
    expectedFrequencyHz: 333
    frequencyTolerancePercent: 5

timer1:
    frequency: 192000000
    0 -> servo_pitch@0

servo_yaw: Sensors.Servo @ sysbus
    minPulseWidthUs: 500
    maxPulseWidthUs: 2500
    minAngle: -90
    maxAngle: 90
    expectedFrequencyHz: 333
    frequencyTolerancePercent: 5

timer1:
    frequency: 192000000
    1 -> servo_yaw@0


rgb_led: Miscellaneous.RGBLed @ sysbus
    expectedFrequencyHz: 1000
    frequencyTolerancePercent: 5

timer2:
    frequency: 192000000
    0 -> rgb_led@0
    1 -> rgb_led@1
    2 -> rgb_led@2

timer4:
    TRGO -> dac1@0

piezo_buzzer: Analog.AnalogAudioRecorder @ dac1

pyro1_en: Miscellaneous.LED @ sysbus
pyro2_en: Miscellaneous.LED @ sysbus

pyro_global_en: Miscellaneous.Button @ sysbus
    -> gpioPortA@12

pyro1_cont: Miscellaneous.Button @ sysbus
    -> gpioPortC@8
pyro2_cont: Miscellaneous.Button @ sysbus
    ->  gpioPortC@9
    
gpioPortA:
    11 -> pyro1_en@0

gpioPortA:
    10 -> pyro2_en@0
