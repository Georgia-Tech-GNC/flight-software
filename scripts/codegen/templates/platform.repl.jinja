// WARNING: THIS IS AN AUTOGENERATED FILE. DO NOT EDIT MANUALLY.
// Edit the template in scripts/codegen/templates/platform.repl.jinja instead

using "{{platform.base_renode_platform}}"

led_1: Miscellaneous.LED @ sysbus
led_2: Miscellaneous.LED @ sysbus
led_3: Miscellaneous.LED @ sysbus

gpioPort{{platform.led_1.gpio_port}}:
    {{platform.led_1.gpio_pin}} -> led_1@0

gpioPort{{platform.led_2.gpio_port}}:
    {{platform.led_2.gpio_pin}} -> led_2@0

gpioPort{{platform.led_3.gpio_port}}:
    {{platform.led_3.gpio_pin}} -> led_3@0

adis16500: Sensors.ADIS16500 @ {{platform.adis16500.renode_spi_id}}

gpioPort{{platform.adis16500.cs_gpio_port}}:
    {{platform.adis16500.cs_gpio_pin}} -> adis16500@0

lsm6dsv: Sensors.LSM6DSV @ {{platform.lsm6dsv.renode_spi_id}}

gpioPort{{platform.lsm6dsv.cs_gpio_port}}:
    {{platform.lsm6dsv.cs_gpio_pin}} -> lsm6dsv@0

lps25hbtr: Sensors.LPS25HBTR @ {{platform.lps25hbtr.renode_i2c_id}} {{platform.lps25hbtr.i2c_address}}

{% for servo in platform.servos %}
servo_{{ servo.name }}: Sensors.Servo @ sysbus
    minPulseWidthUs: {{ platform.servo_config.min_pulse_width_us }}
    maxPulseWidthUs: {{ platform.servo_config.max_pulse_width_us }}
    minAngle: {{ platform.servo_config.min_angle }}
    maxAngle: {{ platform.servo_config.max_angle }}
    expectedFrequencyHz: {{ platform.servo_config.expected_frequency_hz }}
    frequencyTolerancePercent: {{ platform.servo_config.frequency_tolerance_percent }}

{{ platform.servo_config.renode_tim_id }}:
    frequency: {{ platform.servo_config.tim_clk_hz }}
    {{ servo.renode_tim_channel }} -> servo_{{ servo.name }}@0
{% endfor %}

rgb_led: Miscellaneous.RGBLed @ sysbus
    expectedFrequencyHz: {{ platform.rgb_led.expected_frequency_hz }}
    frequencyTolerancePercent: {{ platform.rgb_led.frequency_tolerance_percent }}

{{ platform.rgb_led.renode_tim_id }}:
    frequency: {{ platform.rgb_led.tim_clk_hz }}
    {{ platform.rgb_led.red.renode_tim_channel }} -> rgb_led@0
    {{ platform.rgb_led.green.renode_tim_channel }} -> rgb_led@1
    {{ platform.rgb_led.blue.renode_tim_channel }} -> rgb_led@2

{{platform.buzzer.renode_timer_id}}:
    frequency: {{ platform.buzzer.tim_clk_hz }}
    TRGO -> {{platform.buzzer.renode_dac_id}}@0

piezo_buzzer: Analog.AnalogAudioRecorder @ {{platform.buzzer.renode_dac_id}}

pyro1_en: Miscellaneous.LED @ sysbus
pyro2_en: Miscellaneous.LED @ sysbus

pyro_global_en: Miscellaneous.Button @ sysbus
    -> gpioPort{{platform.pyro.global_en.gpio_port}}@{{platform.pyro.global_en.gpio_pin}}

pyro1_cont: Miscellaneous.Button @ sysbus
    -> gpioPort{{platform.pyro.channel1.continuity.gpio_port}}@{{platform.pyro.channel1.continuity.gpio_pin}}
pyro2_cont: Miscellaneous.Button @ sysbus
    ->  gpioPort{{platform.pyro.channel2.continuity.gpio_port}}@{{platform.pyro.channel2.continuity.gpio_pin}}
    
gpioPort{{platform.pyro.channel1.enable.gpio_port}}:
    {{platform.pyro.channel1.enable.gpio_pin}} -> pyro1_en@0

gpioPort{{platform.pyro.channel2.enable.gpio_port}}:
    {{platform.pyro.channel2.enable.gpio_pin}} -> pyro2_en@0
