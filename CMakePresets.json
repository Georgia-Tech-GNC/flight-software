                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ncl-f429-dev",
            "configurePreset": "ncl-f429-dev"
        },
        {
            "name": "ncl-f429-release",
            "configurePreset": "ncl-f429-release"
        },
        {
            "name": "ncl-h723-dev",
            "configurePreset": "ncl-h723-dev"
        },
        {
