            "toolchainFile": "${sourceDir}/targets/Nucleo-f429zi/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "TARGET_BOARD": "Nucleo-f429zi"
            }
        },
        {
            "name": "default-nucleo-h723zg",
